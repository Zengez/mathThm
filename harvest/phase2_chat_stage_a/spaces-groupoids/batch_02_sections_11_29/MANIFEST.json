      "section": 16,
      "kind": "context_only",
      "source_line": 1763,
      "snippets": [
        {
          "source_line": 1797,
          "tex": "\\begin{definition}\n\\label{definition-stabilizer-groupoid}\nLet $B \\to S$ as in Section \\ref{section-notation}.\nLet $(U, R, s, t, c)$ be a groupoid in algebraic spaces over $B$.\nThe group algebraic space $j^{-1}(\\Delta_{U/B}) \\to U$ is called the\n{\\it stabilizer of the groupoid in algebraic spaces $(U, R, s, t, c)$}.\n\\end{definition}"
        }
      ],
      "stage_a_readiness": "no_active_candidates"
    },
    {
      "section": 17,
      "kind": "candidates",
      "source_line": 1834,
      "stage_a_readiness": "needs_stage_a_work"
    },
    {
      "section": 18,
      "kind": "context_only",
      "source_line": 1916,
      "snippets": [
        {
          "source_line": 1922,
          "tex": "\\begin{definition}\n\\label{definition-invariant-open}\nLet $B \\to S$ as in Section \\ref{section-notation}.\nLet $(U, R, s, t, c)$ be a groupoid in algebraic spaces over the base $B$.\n\\begin{enumerate}\n\\item We say an open subspace $W \\subset U$ is {\\it $R$-invariant} if\n$t(s^{-1}(W)) \\subset W$.\n\\item A locally closed subspace $Z \\subset U$ is called {\\it $R$-invariant}\nif $t^{-1}(Z) = s^{-1}(Z)$ as locally closed subspaces of $R$.\n\\item A monomorphism of algebraic spaces $T \\to U$ is {\\it $R$-invariant}\nif $T \\times_{U, t} R = R \\times_{s, U} T$ as algebraic spaces over $R$.\n\\end{enumerate}\n\\end{definition}"
        }
      ],
      "stage_a_readiness": "no_active_candidates"
    },
