_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-ring-jacobson", "section_opening_preview": null, "section_start_line": 6649, "section_title": "Jacobson rings", "source_filename": "algebra.tex", "source_label": "lemma-finite-residue-extension-closed", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 6844, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/algebra.tex#L6844", "statement_tex": "\\label{lemma-finite-residue-extension-closed}\nLet $R \\to S$ be a ring map.\nLet $\\mathfrak m \\subset R$ be a maximal ideal.\nLet $\\mathfrak q \\subset S$ be a prime ideal\nlying over $\\mathfrak m$ such that $\\kappa(\\mathfrak q)/\\kappa(\\mathfrak m)$\nis an algebraic field extension.\nThen $\\mathfrak q$ is a maximal ideal of $S$.", "statement_truncated": false}
