{"ambient_context_auto_assumed": false, "available_prior_named_context": [], "candidate_id": "candidate.stacks.a253a9320558f2b5eaad1dd3", "candidate_review_status": "needs_actual_mathematical_standalone_reconstruction", "context_events_since_previous_candidate": [{"environment": "lemma", "kind": "enter_local_environment", "line": 6165, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 6170, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 6186, "persists_after_end": false, "scope_stack": ["lemma"]}], "explicit_refs": [], "new_refs_in_this_candidate": [], "prior_conclusions": ["There exists an $f \\in R$, $f \\not \\in \\mathfrak p$ such\nthat $R_f \\to R_\\mathfrak p$ is injective in each of the\nfollowing cases\n\\begin{enumerate}\n\\item $R$ is a domain,\n\\item $R$ is Noetherian, or\n\\item $R$ is reduced and has finitely many minimal primes.\n\\end{enumerate}"], "prior_context_status": "resolved", "prior_hypotheses": ["Let $R$ be a ring and $\\mathfrak p \\subset R$ be a prime."], "proof_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-Noetherian", "section_opening_preview": null, "section_start_line": 5980, "section_title": "Noetherian rings", "source_filename": "algebra.tex", "source_label": "lemma-subring-of-local-ring", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 6186, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/algebra.tex#L6186", "statement_tex": "\\label{lemma-subring-of-local-ring}\nLet $R$ be a ring and $\\mathfrak p \\subset R$ be a prime.\nThere exists an $f \\in R$, $f \\not \\in \\mathfrak p$ such\nthat $R_f \\to R_\\mathfrak p$ is injective in each of the\nfollowing cases\n\\begin{enumerate}\n\\item $R$ is a