{"ambient_context_auto_assumed": false, "available_prior_named_context": [], "candidate_id": "candidate.stacks.5c39959549cbbb731d3f65ae", "candidate_review_status": "needs_actual_mathematical_standalone_reconstruction", "context_events_since_previous_candidate": [{"environment": "lemma", "kind": "enter_local_environment", "line": 7926, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 7930, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 7943, "persists_after_end": false, "scope_stack": ["lemma"]}], "explicit_refs": [], "new_refs_in_this_candidate": [], "prior_conclusions": ["every\ninvertible $\\mathcal{O}_X$-module is the pullback of an invertible\n$\\mathcal{O}_Y$-module."], "prior_context_status": "resolved", "prior_hypotheses": ["Let $f : X \\to Y$ be a finite morphism of schemes. Assume there\nexists an open $V \\subset Y$ such that $f^{-1}(V) \\to V$ is an\nisomorphism and $Y \\setminus V$ is a discrete space."], "proof_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-dimension-one", "section_opening_preview": null, "section_start_line": 7737, "section_title": "One dimensional Noetherian schemes", "source_filename": "varieties.tex", "source_label": "lemma-surjective-pic-birational-finite", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 7943, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/varieties.tex#L7943", "statement_tex": "\\label{lemma-surjective-pic-birational-finite}\nLet $f : X \\to Y$ be a finite morphism of schemes. Assume there\nexists an open $V \\subset Y$ such that $f^{-1}(V) \\to V$ is an\nisomorphism and $Y \\setminus V$ is a discrete space. Then every\ninvertible $\\mathcal{O}_X$-module is the pullback of an invertible\n$\\mathcal{O}_Y$-module.", "statement_truncated": false}
{"ambient_context_auto_assumed": false, "available_prior_named_context": [], "candidate_id": "candidate.stacks.9520b2b516fe9f778b8883a7", "candidate_review_status": "needs_actual_mathematical_standalone_reconstruction", "context_events_since_previous_candidate": [{"environment": "lemma", "kind": "enter_local_environment", "line": 7943, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 7950, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 7989, "persists_after_end": false, "scope_stack": ["lemma"]}], "explicit_refs": [], "new_refs_in_this_candidate": [], "prior_conclusions": ["there exists an invertible sheaf $\\mathcal{L}$ on $X$ whose restriction\nto $Z_i$ is $\\mathcal{L}_i$. Moreover, if we are given sections\n$s_i \\in \\Gamma(Z_i, \\mathcal{L}_i)$ which are nonvanishing at the\npoints of $Z_i \\cap Z_j$, then we can choose $\\mathcal{L}$ such\nthat there exists a $s \\in \\Gamma(X, \\mathcal{L})$ with\n$s|_{Z_i} = s_i$ for all $i$."], "prior_context_status": "resolved", "prior_hypotheses": ["Let $X$ be a scheme. Let $Z_1, \\ldots, Z_n \\subset X$ be closed\nsubschemes. Let $\\mathcal{L}_i$ be an invertible sheaf on $Z_i$.\nAssume that\n\\begin{enumerate}\n\\item $X$ is reduced,\n\\item $X = \\bigcup Z_i$ set theoretically, and\n\\item $Z_i \\cap Z_j$ is a discrete topological space for $i \\not = j$.\n\\end{enumerate}"], "proof_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-dimension-one", "section_opening_preview": null, "section_start_line": 7737, "section_title": "One dimensional Noetherian schemes", "source_filename": "varieties.tex", "source_label": "lemma-glue-invertible-sheaves", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 7989, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/varieties.tex#L7989", "statement_tex": "\\label{lemma-glue-invertible-sheaves}\nLet $X$ be a scheme. Let $Z_1, \\ldots, Z_n \\subset X$ be closed\nsubschemes. Let $\\mathcal{L}_i$ be an invertible sheaf on $Z_i$.\nAssume that\n\\begin{enumerate}\n\\item $X$ is reduced,\n\\item $X = \\bigcup Z_i$ set theoretically, and\n\\item $Z_i \\cap Z_j$ is a discrete topological space for $i \\not = j$.\n\\end{enumerate}\nThen there exists an invertible sheaf $\\mathcal{L}$ on $X$ whose restriction\nto $Z_i$ is $\\mathcal{L}_i$. Moreover, if we are given sections\n$s_i \\in \\Gamma(Z_i, \\mathcal{L}_i)$ which are nonvanishing at the\npoints of $Z_i \\cap Z_j$, then we can choose $\\mathcal{L}$ such\nthat there exists a $s \\in \\Gamma(X, \\mathcal{L})$ with\n$s|_{Z_i} = s_i$ for all $i$.", "statement_truncated": false}
