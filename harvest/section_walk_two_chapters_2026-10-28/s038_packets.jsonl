{"ambient_context_auto_assumed": false, "available_prior_named_context": [], "candidate_id": "candidate.stacks.f0cbfe8a0b22c947515b4cc0", "candidate_review_status": "needs_actual_mathematical_standalone_reconstruction", "context_events_since_previous_candidate": [{"environment": "lemma", "kind": "enter_local_environment", "line": 7746, "persists_after_end": false, "scope_stack": ["lemma"]}], "explicit_refs": [], "new_refs_in_this_candidate": [], "prior_conclusions": ["$R^pj_*\\mathcal{F} = 0$, $p > 0$\nfor every quasi-coherent $\\mathcal{O}_U$-module $\\mathcal{F}$."], "prior_context_status": "resolved", "prior_hypotheses": ["Let $X$ be a scheme all of whose local rings are Noetherian of dimension\n$\\leq 1$. Let $U \\subset X$ be a retrocompact open. Denote\n$j : U \\to X$ the inclusion morphism."], "proof_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-dimension-one", "section_opening_preview": "The main result of this section is that a\nNoetherian separated scheme of dimension $1$ has an\nample invertible sheaf. See\nProposition \\ref{proposition-dim-1-noetherian-separated-has-ample}.", "section_start_line": 7737, "section_title": "One dimensional Noetherian schemes", "source_filename": "varieties.tex", "source_label": "lemma-affine", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 7746, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/varieties.tex#L7746", "statement_tex": "\\label{lemma-affine}\nLet $X$ be a scheme all of whose local rings are Noetherian of dimension\n$\\leq 1$. Let $U \\subset X$ be a retrocompact open. Denote\n$j : U \\to X$ the inclusion morphism. Then $R^pj_*\\mathcal{F} = 0$, $p > 0$\nfor every quasi-coherent $\\mathcal{O}_U$-module $\\mathcal{F}$.", "statement_truncated": false}
{"ambient_context_auto_assumed": false, "available_prior_named_context": [], "candidate_id": "candidate.stacks.d59e5338549fc9ac07462937", "candidate_review_status": "needs_actual_mathematical_standalone_reconstruction", "context_events_since_previous_candidate": [{"environment": "lemma", "kind": "enter_local_environment", "line": 7746, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 7752, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 7772, "persists_after_end": false, "scope_stack": ["lemma"]}], "explicit_refs": [], "new_refs_in_this_candidate": [], "prior_conclusions": ["any quasi-compact open $U \\subset X$ is affine."], "prior_context_status": "resolved", "prior_hypotheses": ["Let $X$ be an affine scheme all of whose local rings are Noetherian\nof dimension $\\leq 1$."], "proof_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-dimension-one", "section_opening_preview": null, "section_start_line": 7737, "section_title": "One dimensional Noetherian schemes", "source_filename": "varieties.tex", "source_label": "lemma-open-in-affine-curve-affine", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 7772, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/varieties.tex#L7772", "statement_tex": "\\label{lemma-open-in-affine-curve-affine}\nLet $X$ be an affine scheme all of whose local rings are Noetherian\nof dimension $\\leq 1$. Then any quasi-compact open $U \\subset X$ is affine.", "statement_truncated": false}
{"ambient_context_auto_assumed": false, "available_prior_named_context": [], "candidate_id": "candidate.stacks.8445aef6b7c61a0be1401de8", "candidate_review_status": "needs_actual_mathematical_standalone_reconstruction", "context_events_since_previous_candidate": [{"environment": "lemma", "kind": "enter_local_environment", "line": 7772, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 7776, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 7796, "persists_after_end": false, "scope_stack": ["lemma"]}], "explicit_refs": [], "new_refs_in_this_candidate": [], "prior_conclusions": ["(1) there exists an invertible $\\mathcal{O}_X$-module $\\mathcal{L}$\nand a section $s$ such that $U = X_s$ and (2) the map\n$\\Pic(X) \\to \\Pic(U)$ is surjective."], "prior_context_status": "resolved", "prior_hypotheses": ["Let $X$ be a scheme. Let $U \\subset X$ be an open. Assume\n\\begin{enumerate}\n\\item $U$ is a retrocompact open of $X$,\n\\item $X \\setminus U$ is discrete, and\n\\item for $x \\in X \\setminus U$ the local ring\n$\\mathcal{O}_{X, x}$ is Noetherian of dimension $\\leq 1$.\n\\end{enumerate}"], "proof_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-dimension-one", "section_opening_preview": null, "section_start_line": 7737, "section_title": "One dimensional Noetherian schemes", "source_filename": "varieties.tex", "source_label": "lemma-complement-codim-1-closed-points", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 7796, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/varieties.tex#L7796", "statement_tex": "\\label{lemma-complement-codim-1-closed-points}\nLet $X$ be a scheme. Let $U \\subset X$ be an open. Assume\n\\begin{enumerate}\n\\item $U$ is a retrocompact open of $X$,\n\\item $X \\setminus U$ is discrete, and\n\\item for $x \\in X \\setminus U$ the local ring\n$\\mathcal{O}_{X, x}$ is Noetherian of dimension $\\leq 1$.\n\\end{enumerate}\nThen (1) there exists an invertible $\\mathcal{O}_X$-module $\\mathcal{L}$\nand a section $s$ such that $U = X_s$ and (2) the map\n$\\Pic(X) \\to \\Pic(U)$ is surjective.", "statement_truncated": false}
{"ambient_context_auto_assumed": false, "available_prior_named_context": [], "candidate_id": "candidate.stacks.e40db09864f337b32a1d6745", "candidate_review_status": "needs_actual_mathematical_standalone_reconstruction", "context_events_since_previous_candidate": [{"environment": "lemma", "kind": "enter_local_environment", "line": 7796, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 7808, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 7855, "persists_after_end": false, "scope_stack": ["lemma"]}], "explicit_refs": [], "new_refs_in_this_candidate": [], "prior_conclusions": ["there exists a globally generated invertible $\\mathcal{O}_X$-module\n$\\mathcal{L}$ and a section $s$ such that $U = X_s$."], "prior_context_status": "resolved", "prior_hypotheses": ["Let $X$ be an integral separated scheme. Let $U \\subset X$ be a nonempty\naffine open such that $X \\setminus U$ is a finite set of points\n$x_1, \\ldots, x_r$ with $\\mathcal{O}_{X, x_i}$ Noetherian of dimension $1$."], "proof_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-dimension-one", "section_opening_preview": null, "section_start_line": 7737, "section_title": "One dimensional Noetherian schemes", "source_filename": "varieties.tex", "source_label": "lemma-find-globally-generated", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 7855, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/varieties.tex#L7855", "statement_tex": "\\label{lemma-find-globally-generated}\nLet $X$ be an integral separated scheme. Let $U \\subset X$ be a nonempty\naffine open such that $X \\setminus U$ is a finite set of points\n$x_1, \\ldots, x_r$ with $\\mathcal{O}_{X, x_i}$ Noetherian of dimension $1$.\nThen there exists a globally generated invertible $\\mathcal{O}_X$-module\n$\\mathcal{L}$ and a section $s$ such that $U = X_s$.", "statement_truncated": false}
{"ambient_context_auto_assumed": false, "available_prior_named_context": [], "candidate_id": "candidate.stacks.3351fb1a649cee7bec32c8e6", "candidate_review_status": "needs_actual_mathematical_standalone_reconstruction", "context_events_since_previous_candidate": [{"environment": "lemma", "kind": "enter_local_environment", "line": 7855, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 7862, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 7893, "persists_after_end": false, "scope_stack": ["lemma"]}], "explicit_refs": [], "new_refs_in_this_candidate": [], "prior_conclusions": ["$X$ has an ample invertible\nsheaf."], "prior_context_status": "resolved", "prior_hypotheses": ["Let $X$ be a quasi-compact scheme. If for every $x \\in X$\nthere exists a pair $(\\mathcal{L}, s)$ consisting of a globally generated\ninvertible sheaf $\\mathcal{L}$ and a global section $s$ such that\n$x \\in X_s$ and $X_s$ is affine,"], "proof_screened": false, "provisional_durable_scope_assertions": [], "schema": "maththm.section-walk-candidate.v1", "section_label": "section-dimension-one", "section_opening_preview": null, "section_start_line": 7737, "section_title": "One dimensional Noetherian schemes", "source_filename": "varieties.tex", "source_label": "lemma-enough-globally-generated-ample", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 7893, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/varieties.tex#L7893", "statement_tex": "\\label{lemma-enough-globally-generated-ample}\nLet $X$ be a quasi-compact scheme. If for every $x \\in X$\nthere exists a pair $(\\mathcal{L}, s)$ consisting of a globally generated\ninvertible sheaf $\\mathcal{L}$ and a global section $s$ such that\n$x \\in X_s$ and $X_s$ is affine, then $X$ has an ample invertible\nsheaf.", "statement_truncated": false}
