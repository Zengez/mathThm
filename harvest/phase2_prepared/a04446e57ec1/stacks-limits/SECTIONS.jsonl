{"candidate_ids": ["candidate.stacks.38751b7433b24bda4cffc627", "candidate.stacks.9995fb4e3cf772d3d8067e0c"], "chapter_number": 102, "locally_named_context_leads": [], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 178, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 666, "tex": "\\section{Finite type closed in finite presentation}"}, {"line": 667, "tex": "\\label{section-finite-type-closed-in-finite-presentation}"}, {"line": 669, "tex": "\\noindent"}, {"line": 670, "tex": "This section is the analogue of"}, {"line": 671, "tex": "Limits of Spaces, Section"}, {"line": 672, "tex": "\\ref{spaces-limits-section-finite-type-closed-in-finite-presentation}."}, {"line": 674, "tex": "\\begin{lemma}"}, {"line": 675, "tex": "\\label{lemma-finite-type-closed-in-finite-presentation}"}, {"line": 676, "tex": "Let $f : \\mathcal{X} \\to Y$ be a morphism from an algebraic stack"}, {"line": 677, "tex": "to an algebraic space. Assume:"}, {"line": 678, "tex": "\\begin{enumerate}"}, {"line": 679, "tex": "\\item $f$ is of finite type and quasi-separated,"}, {"line": 680, "tex": "\\item $Y$ is quasi-compact and quasi-separated."}, {"line": 681, "tex": "\\end{enumerate}"}, {"line": 682, "tex": "Then there exists a morphism of finite presentation"}, {"line": 683, "tex": "$f' : \\mathcal{X}' \\to Y$ and a closed immersion"}, {"line": 684, "tex": "$\\mathcal{X} \\to \\mathcal{X}'$ of"}, {"line": 685, "tex": "algebraic stacks over $Y$."}, {"line": 686, "tex": "\\end{lemma}"}, {"line": 813, "tex": "\\noindent"}, {"line": 814, "tex": "There is a version for separated algebraic stacks."}, {"line": 816, "tex": "\\begin{lemma}"}, {"line": 817, "tex": "\\label{lemma-separated-closed-in-finite-presentation}"}, {"line": 818, "tex": "Let $f : \\mathcal{X} \\to Y$ be a morphism from an algebraic stack"}, {"line": 819, "tex": "to an algebraic space. Assume:"}, {"line": 820, "tex": "\\begin{enumerate}"}, {"line": 821,