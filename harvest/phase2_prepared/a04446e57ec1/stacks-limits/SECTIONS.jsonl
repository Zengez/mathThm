{"candidate_ids": ["candidate.stacks.fcc20bf4a5778db40deca25e", "candidate.stacks.d5cdf6b1f57ea77346fd6fbb", "candidate.stacks.329a49b053f2df83245b676b", "candidate.stacks.6447dd4ecc1938c2f61e9e95", "candidate.stacks.b036c9c4b43c2da62190eee6", "candidate.stacks.b4e20085f522d45902e2fc1b", "candidate.stacks.807f9cf13717e7922a709285"], "chapter_number": 102, "locally_named_context_leads": [{"kind": "definition", "label": "definition-limit-preserving", "line": 58}], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 352, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 40, "tex": "\\section{Morphisms of finite presentation}"}, {"line": 41, "tex": "\\label{section-finite-presentation}"}, {"line": 43, "tex": "\\noindent"}, {"line": 44, "tex": "This section is the analogue of Limits of Spaces, Section"}, {"line": 45, "tex": "\\ref{spaces-limits-section-finite-presentation}."}, {"line": 46, "tex": "There we defined what it means for a transformation of functors"}, {"line": 47, "tex": "on $\\Sch$ to be limit preserving (we suggest looking at the"}, {"line": 48, "tex": "characterization in Limits of Spaces, Lemma"}, {"line": 49, "tex": "\\ref{spaces-limits-lemma-characterize-relative-limit-preserving})."}, {"line": 50, "tex": "In Criteria for Representability, Section"}, {"line": 51, "tex": "\\ref{criteria-section-limit-preserving}"}, {"line": 52, "tex": "we defined the notion ``limit preserving on objects''."}, {"line": 53, "tex": "Recall that in Artin's Axioms, Section \\ref{artin-section-limits}"}, {"line": 54, "tex": "we have defined what it means for a category fibred in groupoids"}, {"line": 55, "tex": "over $\\Sch$ to be limit preserving. Combining these we get"}, {"line": 56, "tex": "the following notion."}, {"line": 58, "tex": "\\begin{definition}"}, {"line": 59, "tex": "\\label{definition-limit-preserving}"}, {"line": 60, "tex": "Let $S$ be a scheme. Let $f : \\mathcal{X} \\to \\mathcal{Y}$ be a"}, {"line": 61, "tex": "$1$-morphism of categories fibred in groupoids over $(\\Sch/S)_{fppf}$."}, {"line": 62, "tex": "We say $f$ is {\\it limit preserving} if for every directed limit"}, {"line": 63, "tex": "$U = \\lim U_i$ of affine schemes over $S$ the diagram"}, {"line": 64, "tex": "$$"}, {"line": 65, "tex": "\\xymatrix{"}, {"line": 66, "tex": "\\colim \\mathcal{X}_{U_i} \\ar[r] \\ar[d]_f & \\mathcal{X}_U \\ar[d]^f \\\\"}, {"line": 67, "tex": "\\colim \\mathcal{Y}_{U_i} \\ar[r] & \\mathcal{Y}_U"}, {"line": 68, "tex": "}"}, {"line": 69, "tex": "$$"}, {"line": 70, "tex": "of fibre categories is $2$-cartesian."}, {"line": 71, "tex": "\\end{definition}"}, {"line": 73, "tex": "\\begin{lemma}"}, {"line": 74, "tex": "\\label{lemma-limit-preserving-objects}"}, {"line": 75, "tex": "Let $S$ be a scheme. Let $f : \\mathcal{X} \\to \\mathcal{Y}$ be a"}, {"line": 76, "tex": "$1$-morphism of categories fibred in groupoids over $(\\Sch/S)_{fppf}$."}, {"line": 77, "tex": "If $f$ is limit preserving (Definition \\ref{definition-limit-preserving}),"}, {"line": 78, "tex": "then $f$ is limit preserving on objects (Criteria for Representability, Section"}, {"line": 79, "tex": "\\ref{criteria-section-limit-preserving})."}, {"line": 80, "tex": "\\end{lemma}"}, {"line": 92, "tex": "\\begin{lemma}"}, {"line": 93, "tex": "\\label{lemma-base-change-limit-preserving}"}, {"line": 94, "tex": "Let $p : \\mathcal{X} \\to \\mathcal{Y}$ and $q : \\mathcal{Z} \\to \\mathcal{Y}$"}, {"line": 95, "tex": "be $1$-morphisms of categories fibred in groupoids over $(\\Sch/S)_{fppf}$."}, {"line": 96, "tex": "If $p : \\mathcal{X} \\to \\mathcal{Y}$ is limit preserving, then so"}, {"line": 97, "tex": "is the base change"}, {"line": 98, "tex": "$p' : \\mathcal{X} \\times_\\mathcal{Y} \\mathcal{Z} \\to \\mathcal{Z}$"}, {"line": 99, "tex": "of $p$ by $q$."}, {"line": 100, "tex": "\\end{lemma}"}, {"line": 132, "tex": "\\begin{lemma}"}, {"line": 133, "tex": "\\label{lemma-composition-limit-preserving}"}, {"line": 134, "tex": "Let $p : \\mathcal{X} \\to \\mathcal{Y}$ and $q : \\mathcal{Y} \\to \\mathcal{Z}$"}, {"line": 135, "tex": "be $1$-morphisms of categories fibred in groupoids over $(\\Sch/S)_{fppf}$."}, {"line": 136, "tex": "If $p$ and $q$ are limit preserving, then so is the composition $q \\circ p$."}, {"line": 137, "tex": "\\end{lemma}"}, {"line": 155, "tex": "\\begin{lemma}"}, {"line": 156, "tex": "\\label{lemma-representable-by-spaces-limit-preserving}"}, {"line": 157, "tex": "Let $p : \\mathcal{X} \\to \\mathcal{Y}$ be a $1$-morphism of categories"}, {"line": 158, "tex": "fibred in groupoids over $(\\Sch/S)_{fppf}$. If $p$ is"}, {"line": 159, "tex": "representable by algebraic spaces, then the following are equivalent:"}, {"line": 160, "tex": "\\begin{enumerate}"}, {"line": 161, "tex": "\\item $p$ is limit preserving,"}, {"line": 162, "tex": "\\item $p$ is limit preserving on objects, and"}, {"line": 163, "tex": "\\item $p$ is locally of finite presentation (see"}, {"line": 164, "tex": "Algebraic Stacks,"}, {"line": 165, "tex": "Definition \\ref{algebraic-definition-relative-representable-property})."}, {"line": 166, "tex": "\\end{enumerate}"}, {"line": 167, "tex": "\\end{lemma}"}, {"line": 255, "tex": "\\begin{lemma}"}, {"line": 256, "tex": "\\label{lemma-limit-preserving-diagonal}"}, {"line": 257, "tex": "Let $p : \\mathcal{X} \\to \\mathcal{Y}$ be a $1$-morphism of categories"}, {"line": 258, "tex": "fibred in groupoids over $(\\Sch/S)_{fppf}$. The following are equivalent"}, {"line": 259, "tex": "\\begin{enumerate}"}, {"line": 260, "tex": "\\item the diagonal"}, {"line": 261, "tex": "$\\Delta : \\mathcal{X} \\to \\mathcal{X} \\times_\\mathcal{Y} \\mathcal{X}$"}, {"line": 262, "tex": "is limit preserving, and"}, {"line": 263, "tex": "\\item for every directed limit $U = \\lim U_i$ of affine schemes over $S$"}, {"line": 264, "tex": "the functor"}, {"line": 265, "tex": "$$"}, {"line": 266, "tex": "\\colim \\mathcal{X}_{U_i} \\longrightarrow"}, {"line": 267, "tex": "\\mathcal{X}_U \\times_{\\mathcal{Y}_U} \\colim \\mathcal{Y}_{U_i}"}, {"line": 268, "tex": "$$"}, {"line": 269, "tex": "is fully faithful."}, {"line": 270, "tex": "\\end{enumerate}"}, {"line": 271, "tex": "In particular, if $p$ is limit preserving, then $\\Delta$ is too."}, {"line": 272, "tex": "\\end{lemma}"}, {"line": 360, "tex": "\\begin{lemma}"}, {"line": 361, "tex": "\\label{lemma-locally-finite-presentation-limit-preserving}"}, {"line": 362, "tex": "Let $S$ be a scheme. Let $\\mathcal{X}$ be an algebraic stack"}, {"line": 363, "tex": "over $S$. If $\\mathcal{X} \\to S$ is locally of finite presentation,"}, {"line": 364, "tex": "then $\\mathcal{X}$ is limit preserving in the sense of"}, {"line": 365, "tex": "Artin's Axioms, Definition \\ref{artin-definition-limit-preserving}"}, {"line": 366, "tex": "(equivalently: the morphism $\\mathcal{X} \\to S$ is limit preserving)."}, {"line": 367, "tex": "\\end{lemma}"}, {"line": 444, "tex": "\\begin{proposition}"}, {"line": 445, "tex": "\\label{proposition-characterize-locally-finite-presentation}"}, {"line": 446, "tex": "\\begin{reference}"}, {"line": 447, "tex": "This is a special case of \\cite[Lemma 2.3.15]{Emerton-Gee}"}, {"line": 448, "tex": "\\end{reference}"}, {"line": 449, "tex": "Let $f : \\mathcal{X} \\to \\mathcal{Y}$ be a morphism of algebraic stacks."}, {"line": 450, "tex": "The following are equivalent"}, {"line": 451, "tex": "\\begin{enumerate}"}, {"line": 452, "tex": "\\item $f$ is limit preserving,"}, {"line": 453, "tex": "\\item $f$ is limit preserving on objects, and"}, {"line": 454, "tex": "\\item $f$ is locally of finite presentation."}, {"line": 455, "tex": "\\end{enumerate}"}, {"line": 456, "tex": "\\end{proposition}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 516, "section_label": "section-finite-presentation", "section_start_line": 40, "section_title": "Morphisms of finite presentation", "source_f