 V| \\to |\\mathcal{X} \\times_Y Z'|$."}, {"line": 918, "tex": "\\end{enumerate}"}, {"line": 919, "tex": "\\end{lemma}"}, {"line": 974, "tex": "\\begin{lemma}"}, {"line": 975, "tex": "\\label{lemma-test-universally-closed}"}, {"line": 976, "tex": "Let $f : \\mathcal{X} \\to \\mathcal{Y}$ be a quasi-compact morphism of"}, {"line": 977, "tex": "algebraic stacks. The following are equivalent"}, {"line": 978, "tex": "\\begin{enumerate}"}, {"line": 979, "tex": "\\item $f$ is universally closed,"}, {"line": 980, "tex": "\\item for every morphism $Z \\to \\mathcal{Y}$ which is locally of finite"}, {"line": 981, "tex": "presentation and where $Z$ is an affine scheme"}, {"line": 982, "tex": "the map $|\\mathcal{X} \\times_Y Z| \\to |Z|$ is closed, and"}, {"line": 983, "tex": "\\item there exists a scheme $V$ and a surjective smooth morphism"}, {"line": 984, "tex": "$V \\to \\mathcal{Y}$ such that"}, {"line": 985, "tex": "$|\\mathbf{A}^n \\times (\\mathcal{X} \\times_\\mathcal{Y} V)|"}, {"line": 986, "tex": "\\to |\\mathbf{A}^n \\times V|$ is closed for all $n \\geq 0$."}, {"line": 987, "tex": "\\end{enumerate}"}, {"line": 988, "tex": "\\end{lemma}"}, {"line": 1109, "tex": "\\input{chapters}"}, {"line": 1111, "tex": "\\bibliography{my}"}, {"line": 1112, "tex": "\\bibliographystyle{amsalpha}"}, {"line": 1114, "tex": "\\end{document}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 1115, "section_label": "section-universally-closed", "section_start_line": 890, "section_title": "Universally closed morphisms", "source_file": "stacks-limits.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"environment": "lemma", "kind": "enter_local_environment", "line": 897, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 897, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line"