{"candidate_ids": ["candidate.stacks.cb9af25b6eb67af758e65a22", "candidate.stacks.669d1555ba03ca5f52f93b75", "candidate.stacks.ee7711283a091edc8ff683fc", "candidate.stacks.9c7f9374c16ca8abaad92747", "candidate.stacks.1605c94156809f95d01fc0ee"], "chapter_number": 44, "locally_named_context_leads": [{"kind": "remark", "label": "remark-universal-object-hilb-d", "line": 694}], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 168, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 398, "tex": "\\section{Moduli of divisors on smooth curves}"}, {"line": 399, "tex": "\\label{section-divisors}"}, {"line": 401, "tex": "\\noindent"}, {"line": 402, "tex": "For a smooth morphism $X \\to S$ of relative dimension $1$ the functor"}, {"line": 403, "tex": "$\\Hilbfunctor^d_{X/S}$ parametrizes relative effective Cartier divisors"}, {"line": 404, "tex": "as defined in"}, {"line": 405, "tex": "Divisors, Section \\ref{divisors-section-effective-Cartier-morphisms}."}, {"line": 407, "tex": "\\begin{lemma}"}, {"line": 408, "tex": "\\label{lemma-divisors-on-curves}"}, {"line": 409, "tex": "Let $X \\to S$ be a smooth morphism of schemes of relative dimension $1$."}, {"line": 410, "tex": "Let $D \\subset X$ be a closed subscheme. Consider the following conditions"}, {"line": 411, "tex": "\\begin{enumerate}"}, {"line": 412, "tex": "\\item $D \\to S$ is finite locally free,"}, {"line": 413, "tex": "\\item $D$ is a relative effective Cartier divisor on $X/S$,"}, {"line": 414, "tex": "\\item $D \\to S$ is locally quasi-finite, flat, and"}, {"line": 415, "tex": "locally of finite presentation, and"}, {"line": 416, "tex": "\\item $D \\to S$ is locally quasi-finite and flat."}, {"line": 417, "tex": "\\end{enumerate}"}, {"line": 418, "tex": "We always have the implications"}, {"line": 419, "tex": "$$"}, {"line": 420, "tex": "(1) \\Rightarrow (2) \\Leftrightarrow (3) \\Rightarrow (4)"}, {"line": 421, "tex": "$$"}, {"line": 422, "tex": "If $S$ is locally Noetherian, then the last arrow is an if and only if."}, {"line": 423, "tex": "If $X \\to S$ is proper (and $S$ arbitrary), then the first arrow is"}, {"line": 424, "tex": "an if and only if."}, {"line": 425, "tex": "\\end{lemma}"}, {"line": 460, "tex": "\\begin{lemma}"}, {"line": 461, "tex": "\\label{lemma-sum-divisors-on-curves}"}, {"line": 462, "tex": "Let $X \\to S$ be a smooth morphism of schemes of relative dimension $1$."}, {"line": 463, "tex": "Let $D_1, D_2 \\subset X$ be closed subschemes finite locally free of"}, {"line": 464, "tex": "degrees $d_1$, $d_2$ over $S$. Then $D_1 + D_2$ is finite locally free"}, {"line": 465, "tex": "of degree $d_1 + d_2$ over $S$."}, {"line": 466, "tex": "\\end{lemma}"}, {"line": 508, "tex": "\\begin{lemma}"}, {"line": 509, "tex": "\\label{lemma-difference-divisors-on-curves}"}, {"line": 510, "tex": "Let $X \\to S$ be a smooth morphism of schemes of relative dimension $1$."}, {"line": 511, "tex": "Let $D_1, D_2 \\subset X$ be closed subschemes finite locally free of"}, {"line": 512, "tex": "degrees $d_1$, $d_2$ over $S$. If $D_1 \\subset D_2$ (as closed subschemes)"}, {"line": 513, "tex": "then there is a closed subscheme $D \\subset X$ finite locally free of"}, {"line": 514, "tex": "degree $d_2 - d_1$ over $S$ such that $D_2 = D_1 + D$."}, {"line": 515, "tex": "\\end{lemma}"}, {"line": 535, "tex": "\\noindent"}, {"line": 536, "tex": "Let $X \\to S$ be a smooth morphism of schemes of relative dimension $1$."}, {"line": 537, "tex": "By Lemma \\ref{lemma-divisors-on-curves} for a scheme $T$ over $S$ and"}, {"line": 538, "tex": "$D \\in \\Hilbfunctor^d_{X/S}(T)$, we can view $D$ as a relative"}, {"line": 539, "tex": "effective Cartier divisor on $X_T/T$ such that $D \\to T$ is finite"}, {"line": 540, "tex": "locally free of degree $d$. Hence, by"}, {"line": 541, "tex": "Lemma \\ref{lemma-sum-divisors-on-curves} we obtain a transformation"}, {"line": 542, "tex": "of functors"}, {"line": 543, "tex": "$$"}, {"line": 544, "tex": "\\Hilbfunctor^{d_1}_{X/S} \\times \\Hilbfunctor^{d_2}_{X/S}"}, {"line": 545, "tex": "\\longrightarrow"}, {"line": 546, "tex": "\\Hilbfunctor^{d_1 + d_2}_{X/S},\\quad"}, {"line": 547, "tex": "(D_1, D_2) \\longmapsto D_1 + D_2"}, {"line": 548, "tex": "$$"}, {"line": 549, "tex": "If $\\Hilbfunctor^d_{X/S}$ is representable for all degrees $d$, then"}, {"line": 550, "tex": "this transformation of functors corresponds to a morphism of schemes"}, {"line": 551, "tex": "$$"}, {"line": 552, "tex": "\\underline{\\Hilbfunctor}^{d_1}_{X/S}"}, {"line": 553, "tex": "\\times_S"}, {"line": 554, "tex": "\\underline{\\Hilbfunctor}^{d_2}_{X/S}"}, {"line": 555, "tex": "\\longrightarrow"}, {"line": 556, "tex": "\\underline{\\Hilbfunctor}^{d_1 + d_2}_{X/S}"}, {"line": 557, "tex": "$$"}, {"line": 558, "tex": "over $S$. Observe that $\\underline{\\Hilbfunctor}^0_{X/S} = S$ and"}, {"line": 559, "tex": "$\\underline{\\Hilbfunctor}^1_{X/S} = X$."}, {"line": 560, "tex": "A special case of the morphism above is the morphism"}, {"line": 561, "tex": "$$"}, {"line": 562, "tex": "\\underline{\\Hilbfunctor}^d_{X/S} \\times_S X"}, {"line": 563, "tex": "\\longrightarrow"}, {"line": 564, "tex": "\\underline{\\Hilbfunctor}^{d + 1}_{X/S},\\quad"}, {"line": 565, "tex": "(D, x) \\longmapsto D + x"}, {"line": 566, "tex": "$$"}, {"line": 568, "tex": "\\begin{lemma}"}, {"line": 569, "tex": "\\label{lemma-universal-object}"}, {"line": 570, "tex": "Let $X \\to S$ be a smooth morphism of schemes of relative dimension $1$"}, {"line": 571, "tex": "such that the functors $\\Hilbfunctor^d_{X/S}$ are representable. The morphism"}, {"line": 572, "tex": "$\\underline{\\Hilbfunctor}^d_{X/S} \\times_S X \\to"}, {"line": 573, "tex": "\\underline{\\Hilbfunctor}^{d + 1}_{X/S}$"}, {"line": 574, "tex": "is finite locally free of degree $d + 1$."}, {"line": 575, "tex": "\\end{lemma}"}, {"line": 601, "tex": "\\begin{lemma}"}, {"line": 602, "tex": "\\label{lemma-hilb-d-smooth}"}, {"line": 603, "tex": "Let $X \\to S$ be a smooth morphism of schemes of relative dimension $1$"}, {"line": 604, "tex": "such that the functors $\\Hilbfunctor^d_{X/S}$ are representable. The"}, {"line": 605, "tex": "schemes $\\underline{\\Hilbfunctor}^d_{X/S}$ are smooth over $S$ of"}, {"line": 606, "tex": "relative dimension $d$."}, {"line": 607, "tex": "\\end{lemma}"}, {"line": 627, "tex": "\\noindent"}, {"line": 628, "tex": "We collect all the information obtained sofar in the case of"}, {"line": 629, "tex": "a proper smooth curve over a field."}, {"line": 631, "tex": "\\begin{proposition}"}, {"line": 632, "tex": "\\label{proposition-hilb-d}"}, {"line": 633, "tex": "Let $X$ be a geometrically irreducible smooth proper curve over a field $k$."}, {"line": 634, "tex": "\\begin{enumerate}"}, {"line": 635, "tex": "\\item The functors $\\Hilbfunctor^d_{X/k}$ are representable by smooth"}, {"line": 636, "tex": "proper varieties $\\underline{\\Hilbfunctor}^d_{X/k}$ of dimension"}, {"line": 637, "tex": "$d$ over $k$."}, {"line": 638, "tex": "\\item For a field extension $k'/k$ the $k'$-rational points"}, {"line": 639, "tex": "of $\\underline{\\Hilbfunctor}^d_{X/k}$ are in $1$-to-$1$ bijection"}, {"line": 640, "tex": "with effective Cartier divisors of degree $d$ on $X_{k'}$."}, {"line": 641, "tex": "\\item For $d_1, d_2 \\geq 0$ there is a morphism"}, {"line": 642, "tex": "$$"}, {"line": 643, "tex": "\\underline{\\Hilbfunctor}^{d_1}_{X/k}"}, {"line": 644, "tex": "\\times_k"}, {"line": 645, "tex": "\\underline{\\Hilbfunctor}^{d_2}_{X/k}"}, {"line": 646, "tex": "\\longrightarrow"}, {"line": 647, "tex": "\\underline{\\Hilbfunctor}^{d_1 + d_2}_{X/k}"}, {"line": 648, "tex": "$$"}, {"line": 649, "tex": "which is finite locally free of degree ${d_1 + d_2 \\choose d_1}$."}, {"line": 650, "tex": "\\end{enumerate}"}, {"line": 651, "tex": "\\end{proposition}"}, {"line": 694, "tex": "\\begin{remark}"}, {"line": 695, "tex": "\\label{remark-universal-object-hilb-d}"}, {"line": 696, "tex": "Let $X$ be a geometrically irreducible smooth proper curve over a field $k$"}, {"line": 697, "tex": "as in Proposition \\ref{proposition-hilb-d}. Let $d \\geq 0$. The universal"}, {"line": 698, "tex": "closed object is a relatively effective divisor"}, {"line": 699, "tex": "$$"}, {"line": 700, "tex": "D_{univ} \\subset \\underline{\\Hilbfunctor}^{d + 1}_{X/k} \\times_k X"}, {"line": 701, "tex": "$$"}, {"line": 702, "tex": "over $\\underline{\\Hilbfunctor}^{d + 1}_{X/k}$ by"}, {"line": 703, "tex": "Lemma \\ref{lemma-divisors-on-curves}."}, {"line": 704, "tex": "In fact, $D_{univ}$ is isomorphic as a scheme to"}, {"line": 705, "tex": "$\\underline{\\Hilbfunctor}^d_{X/k} \\times_k X$, see proof of"}, {"line": 706, "tex": "Lemma \\ref{lemma-universal-object}."}, {"line": 707, "tex": "In particular, $D_{univ}$ is an effective Cartier divisor and"}, {"line": 708, "tex": "we obtain an invertible module"}, {"line": 709, "tex": "$\\mathcal{O}(D_{univ})$. If $[D] \\in \\underline{\\Hilbfunctor}^{d + 1}_{X/k}$"}, {"line": 710, "tex": "denotes the $k$-rational point corresponding to the effective"}, {"line": 711, "tex": "Cartier divisor $D \\subset X$ of degree $d + 1$, then the restriction"}, {"line": 712, "tex": "of $\\mathcal{O}(D_{univ})$ to the fibre $[D] \\times X$ is"}, {"line": 713, "tex": "$\\mathcal{O}_X(D)$."}, {"line": 714, "tex": "\\end{remark}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 716, "section_label": "section-divisors", "section_start_line": 398, "section_title": "Moduli of divisors on smooth curves", "source_file": "pic.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"environment": "lemma", "kind": "enter_local_environment", "line": 407, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 425, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 427, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 460, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 460, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 466, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 468, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 508, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 508, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 515, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 517, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 568, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 568, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 575, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 577, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 601, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 601, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 607, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 609, "scope_stack": []}, {"environment": "proposition", "kind": "enter_local_environment", "line": 631, "persists_after_end": false, "scope_stack": ["proposition"]}, {"kind": "candidate_location", "line": 631, "scope_stack": ["proposition"]}, {"environment": "proposition", "kind": "exit_local_environment", "line": 651, "persists_after_end": false, "scope_stack_before_pop": ["proposition"]}, {"kind": "proof_skipped", "line": 653, "scope_stack": []}, {"environment": "remark", "kind": "enter_local_environment", "line": 694, "persists_after_end": false, "scope_stack": ["remark"]}, {"environment": "remark", "kind": "exit_local_environment", "line": 714, "persists_after_end": false, "scope_stack_before_pop": ["remark"]}]}
{"candidate_ids": ["candidate.stacks.1ef781e776145c56a8b5d237", "candidate.stacks.c791444796440aaf4078a6a5"], "chapter_number": 44, "locally_named_context_leads": [{"kind": "definition", "label": "definition-picard-functor", "line": 739}], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 91, "possible_scope_prose_line_numbers": [733], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 717, "tex": "\\section{The Picard functor}"}, {"line": 718, "tex": "\\label{section-picard-functor}"}, {"line": 720, "tex": "\\noindent"}, {"line": 721, "tex": "Given any scheme $X$ we denote $\\Pic(X)$ the set of isomorphism"}, {"line": 722, "tex": "classes of invertible $\\mathcal{O}_X$-modules."}, {"line": 723, "tex": "See Modules, Definition \\ref{modules-definition-pic}."}, {"line": 724, "tex": "Given a morphism $f : X \\to Y$ of schemes, pullback defines"}, {"line": 725, "tex": "a group homomorphism $\\Pic(Y) \\to \\Pic(X)$."}, {"line": 726, "tex": "The assignment"}, {"line": 727, "tex": "$X \\leadsto \\Pic(X)$ is a contravariant functor from the category"}, {"line": 728, "tex": "of schemes to the category of abelian groups. This functor is not"}, {"line": 729, "tex": "representable, but it turns out that a relative variant of this"}, {"line": 730, "tex": "construction sometimes is representable."}, {"line": 732, "tex": "\\medskip\\noindent"}, {"line": 733, "tex": "Let us define the Picard functor for a morphism of schemes $f : X \\to S$."}, {"line": 734, "tex": "The idea behind our construction is that we'll take it to be the sheaf"}, {"line": 735, "tex": "$R^1f_*\\mathbf{G}_m$ where we use the fppf topology to compute the higher"}, {"line": 736, "tex": "direct image. Unwinding the definitions this leads to the following more"}, {"line": 737, "tex": "direct definition."}, {"line": 739, "tex": "\\begin{definition}"}, {"line": 740, "tex": "\\label{definition-picard-functor}"}, {"line": 741, "tex": "Let $\\Sch_{fppf}$ be a big site as in"}, {"line": 742, "tex": "Topologies, Definition \\ref{topologies-definition-big-small-fppf}."}, {"line": 743, "tex": "Let $f : X \\to S$ be a morphism of this site. The {\\it Picard functor}"}, {"line": 744, "tex": "$\\Picardfunctor_{X/S}$ is the fppf sheafification of the functor"}, {"line": 745, "tex": "$$"}, {"line": 746, "tex": "(\\Sch/S)_{fppf} \\longrightarrow \\textit{Sets},\\quad"}, {"line": 747, "tex": "T \\longmapsto \\Pic(X_T)"}, {"line": 748, "tex": "$$"}, {"line": 749, "tex": "If this functor is representable, then we denote"}, {"line": 750, "tex": "$\\underline{\\Picardfunctor}_{X/S}$ a scheme representing it."}, {"line": 751, "tex": "\\end{definition}"}, {"line": 753, "tex": "\\noindent"}, {"line": 754, "tex": "An often used remark is that if $T \\in \\Ob((\\Sch/S)_{fppf})$, then"}, {"line": 755, "tex": "$\\Picardfunctor_{X_T/T}$ is the restriction of $\\Picardfunctor_{X/S}$ to"}, {"line": 756, "tex": "$(\\Sch/T)_{fppf}$."}, {"line": 757, "tex": "It turns out to be nontrivial to see what the value of $\\Picardfunctor_{X/S}$"}, {"line": 758, "tex": "is on schemes $T$ over $S$. Here is a lemma that helps with this"}, {"line": 759, "tex": "task."}, {"line": 761, "tex": "\\begin{lemma}"}, {"line": 762, "tex": "\\label{lemma-flat-geometrically-connected-fibres}"}, {"line": 763, "tex": "Let $f : X \\to S$ be as in Definition \\ref{definition-picard-functor}."}, {"line": 764, "tex": "If $\\mathcal{O}_T \\to f_{T, *}\\mathcal{O}_{X_T}$ is an isomorphism"}, {"line": 765, "tex": "for all $T \\in \\Ob((\\Sch/S)_{fppf})$, then"}, {"line": 766, "tex": "$$"}, {"line": 767, "tex": "0 \\to \\Pic(T) \\to \\Pic(X_T) \\to \\Picardfunctor_{X/S}(T)"}, {"line": 768, "tex": "$$"}, {"line": 769, "tex": "is an exact sequence for all $T$."}, {"line": 770, "tex": "\\end{lemma}"}, {"line": 810, "tex": "\\begin{lemma}"}, {"line": 811, "tex": "\\label{lemma-flat-geometrically-connected-fibres-with-section}"}, {"line": 812, "tex": "Let $f : X \\to S$ be as in Definition \\ref{definition-picard-functor}."}, {"line": 813, "tex": "Assume $f$ has a section $\\sigma$ and that"}, {"line": 814, "tex": "$\\mathcal{O}_T \\to f_{T, *}\\mathcal{O}_{X_T}$ is an isomorphism"}, {"line": 815, "tex": "for all $T \\in \\Ob((\\Sch/S)_{fppf})$. Then"}, {"line": 816, "tex": "$$"}, {"line": 817, "tex": "0 \\to \\Pic(T) \\to \\Pic(X_T) \\to \\Picardfunctor_{X/S}(T) \\to 0"}, {"line": 818, "tex": "$$"}, {"line": 819, "tex": "is a split exact sequence with splitting given by"}, {"line": 820, "tex": "$\\sigma_T^* : \\Pic(X_T) \\to \\Pic(T)$."}, {"line": 821, "tex": "\\end{lemma}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 879, "section_label": "section-picard-functor", "section_start_line": 717, "section_title": "The Picard functor", "source_file": "pic.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"kind": "local_or_unclassified_prose", "line": 733, "review_required": true, "scope_stack": [], "text_excerpt": "Let us define the Picard functor for a morphism of schemes $f : X \\to S$. The idea behind our construction is that we'll take it to be the sheaf $R^1f_*\\mathbf{G}_m$ where we use the fppf topology to compute the higher direct image. Unwinding the definitions this leads to the following more direct definition."}, {"environment": "definition", "kind": "enter_local_environment", "line": 739, "persists_after_end": false, "scope_stack": ["definition"]}, {"environment": "definition", "kind": "exit_local_environment", "line": 751, "persists_after_end": false, "scope_stack_before_pop": ["definition"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 761, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 761, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 770, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 772, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 810, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 810, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 821, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 823, "scope_stack": []}]}
{"candidate_ids": ["candidate.stacks.ea0d75dea55ce937ee740f51"], "chapter_number": 44, "locally_named_context_leads": [], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 10, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 880, "tex": "\\section{A representability criterion}"}, {"line": 881, "tex": "\\label{section-representability}"}, {"line": 883, "tex": "\\noindent"}, {"line": 884, "tex": "To prove the Picard functor is representable we will use the following"}, {"line": 885, "tex": "criterion."}, {"line": 887, "tex": "\\begin{lemma}"}, {"line": 888, "tex": "\\label{lemma-criterion}"}, {"line": 889, "tex": "Let $k$ be a field. Let $G : (\\Sch/k)^{opp} \\to \\textit{Groups}$ be a"}, {"line": 890, "tex": "functor. With terminology as in"}, {"line": 891, "tex": "Schemes, Definition \\ref{schemes-definition-representable-by-open-immersions},"}, {"line": 892, "tex": "assume that"}, {"line": 893, "tex": "\\begin{enumerate}"}, {"line": 894, "tex": "\\item $G$ satisfies the sheaf property for the Zariski topology,"}, {"line": 895, "tex": "\\item there exists a subfunctor $F \\subset G$ such that"}, {"line": 896, "tex": "\\begin{enumerate}"}, {"line": 897, "tex": "\\item $F$ is representable,"}, {"line": 898, "tex": "\\item $F \\subset G$ is representable by open immersion,"}, {"line": 899, "tex": "\\item for every field extension $K$ of $k$ and $g \\in G(K)$"}, {"line": 900, "tex": "there exists a $g' \\in G(k)$ such that $g'g \\in F(K)$."}, {"line": 901, "tex": "\\end{enumerate}"}, {"line": 902, "tex": "\\end{enumerate}"}, {"line": 903, "tex": "Then $G$ is representable by a group scheme over $k$."}, {"line": 904, "tex": "\\end{lemma}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 918, "section_label": "section-representability", "section_start_line": 880, "section_title": "A representability criterion", "source_file": "pic.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"environment": "lemma", "kind": "enter_local_environment", "line": 887, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 887, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 904, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 906, "scope_stack": []}]}
{"candidate_ids": ["candidate.stacks.e37747aa3218044686c8a6fb", "candidate.stacks.4b1968c32409460309b91cf2", "candidate.stacks.633977e83ef57a68653ecffd", "candidate.stacks.92e51c0a48caf7dbc2508964", "candidate.stacks.9f33e4888828d30cbc827791", "candidate.stacks.6dc82e476a0c9b113c6884e0"], "chapter_number": 44, "locally_named_context_leads": [{"kind": "definition", "label": "definition-genus", "line": 990}], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 296, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 919, "tex": "\\section{The Picard scheme of a curve}"}, {"line": 920, "tex": "\\label{section-picard-curve}"}, {"line": 922, "tex": "\\noindent"}, {"line": 923, "tex": "In this section we will apply Lemma \\ref{lemma-criterion} to show that"}, {"line": 924, "tex": "$\\Picardfunctor_{X/k}$ is representable, when $k$ is an algebraically"}, {"line": 925, "tex": "closed field and $X$ is a smooth projective curve over $k$. To make this"}, {"line": 926, "tex": "work we use a bit of cohomology and base change developed in"}, {"line": 927, "tex": "the chapter on derived categories of schemes."}, {"line": 929, "tex": "\\begin{lemma}"}, {"line": 930, "tex": "\\label{lemma-check-conditions}"}, {"line": 931, "tex": "Let $k$ be a field. Let $X$ be a smooth projective curve over $k$"}, {"line": 932, "tex": "which has a $k$-rational point. Then the hypotheses of"}, {"line": 933, "tex": "Lemma \\ref{lemma-flat-geometrically-connected-fibres-with-section}"}, {"line": 934, "tex": "are satisfied."}, {"line": 935, "tex": "\\end{lemma}"}, {"line": 952, "tex": "\\noindent"}, {"line": 953, "tex": "Let $X$ be a smooth projective curve over a field $k$ with a"}, {"line": 954, "tex": "$k$-rational point $\\sigma$. Then the functor"}, {"line": 955, "tex": "$$"}, {"line": 956, "tex": "\\Picardfunctor_{X/k, \\sigma} : (\\Sch/k)^{opp} \\longrightarrow \\textit{Ab},\\quad"}, {"line": 957, "tex": "T \\longmapsto \\Ker(\\Pic(X_T) \\xrightarrow{\\sigma_T^*} \\Pic(T))"}, {"line": 958, "tex": "$$"}, {"line": 959, "tex": "is isomorphic to $\\Picardfunctor_{X/k}$ on $(\\Sch/k)_{fppf}$"}, {"line": 960, "tex": "by Lemmas \\ref{lemma-check-conditions} and"}, {"line": 961, "tex": "\\ref{lemma-flat-geometrically-connected-fibres-with-section}."}, {"line": 962, "tex": "Hence it will suffice to prove that $\\Picardfunctor_{X/k, \\sigma}$"}, {"line": 963, "tex": "is representable. We will use the notation"}, {"line": 964, "tex": "``$\\mathcal{L} \\in \\Picardfunctor_{X/k, \\sigma}(T)$'' to signify that"}, {"line": 965, "tex": "$T$ is a scheme over $k$ and $\\mathcal{L}$ is an invertible"}, {"line": 966, "tex": "$\\mathcal{O}_{X_T}$-module whose restriction to $T$ via $\\sigma_T$"}, {"line": 967, "tex": "is isomorphic to $\\mathcal{O}_T$."}, {"line": 969, "tex": "\\begin{lemma}"}, {"line": 970, "tex": "\\label{lemma-define-open}"}, {"line": 971, "tex": "Let $k$ be a field. Let $X$ be a smooth projective curve over $k$"}, {"line": 972, "tex": "with a $k$-rational point $\\sigma$. For a scheme $T$ over $k$,"}, {"line": 973, "tex": "consider the subset $F(T) \\subset \\Picardfunctor_{X/k, \\sigma}(T)$ consisting of"}, {"line": 974, "tex": "$\\mathcal{L}$ such that $Rf_{T, *}\\mathcal{L}$ is isomorphic to an invertible"}, {"line": 975, "tex": "$\\mathcal{O}_T$-module placed in degree $0$. Then"}, {"line": 976, "tex": "$F \\subset \\Picardfunctor_{X/k, \\sigma}$ is a subfunctor and the inclusion is"}, {"line": 977, "tex": "representable by open immersions."}, {"line": 978, "tex": "\\end{lemma}"}, {"line": 987, "tex": "\\noindent"}, {"line": 988, "tex": "To continue it is convenient to make the following definition."}, {"line": 990, "tex": "\\begin{definition}"}, {"line": 991, "tex": "\\label{definition-genus}"}, {"line": 992, "tex": "Let $k$ be a field. Let $X$ be a smooth projective geometrically irreducible"}, {"line": 993, "tex": "curve over $k$. The {\\it genus} of $X$ is $g = \\dim_k H^1(X, \\mathcal{O}_X)$."}, {"line": 994, "tex": "\\end{definition}"}, {"line": 996, "tex": "\\begin{lemma}"}, {"line": 997, "tex": "\\label{lemma-open-representable}"}, {"line": 998, "tex": "Let $k$ be a field. Let $X$ be a smooth projective curve of genus $g$"}, {"line": 999, "tex": "over $k$ with a $k$-rational point $\\sigma$. The open subfunctor $F$ defined"}, {"line": 1000, "tex": "in Lemma \\ref{lemma-define-open} is representable by an open subscheme of"}, {"line": 1001, "tex": "$\\underline{\\Hilbfunctor}^g_{X/k}$."}, {"line": 1002, "tex": "\\end{lemma}"}, {"line": 1099, "tex": "\\begin{lemma}"}, {"line": 1100, "tex": "\\label{lemma-twist-with-general-divisor}"}, {"line": 1101, "tex": "Let $k$ be a separably closed field. Let $X$ be a smooth projective"}, {"line": 1102, "tex": "curve of genus $g$ over $k$. Let $K/k$ be a field extension and let"}, {"line": 1103, "tex": "$\\mathcal{L}$ be an invertible sheaf on $X_K$. Then there exists an"}, {"line": 1104, "tex": "invertible sheaf $\\mathcal{L}_0$ on $X$ such that"}, {"line": 1105, "tex": "$\\dim_K H^0(X_K,"}, {"line": 1106, "tex": "\\mathcal{L} \\otimes_{\\mathcal{O}_{X_K}} \\mathcal{L}_0|_{X_K}) = 1$ and"}, {"line": 1107, "tex": "$\\dim_K H^1(X_K,"}, {"line": 1108, "tex": "\\mathcal{L} \\otimes_{\\mathcal{O}_{X_K}} \\mathcal{L}_0|_{X_K}) = 0$."}, {"line": 1109, "tex": "\\end{lemma}"}, {"line": 1159, "tex": "\\begin{proposition}"}, {"line": 1160, "tex": "\\label{proposition-pic-curve}"}, {"line": 1161, "tex": "Let $k$ be a separably closed field. Let $X$ be a smooth projective"}, {"line": 1162, "tex": "curve over $k$. The Picard functor $\\Picardfunctor_{X/k}$ is representable."}, {"line": 1163, "tex": "\\end{proposition}"}, {"line": 1191, "tex": "\\noindent"}, {"line": 1192, "tex": "In fact, the proof given above produces more information which we"}, {"line": 1193, "tex": "collect here."}, {"line": 1195, "tex": "\\begin{lemma}"}, {"line": 1196, "tex": "\\label{lemma-picard-pieces}"}, {"line": 1197, "tex": "Let $k$ be a separably closed field. Let $X$ be a smooth projective"}, {"line": 1198, "tex": "curve of genus $g$ over $k$."}, {"line": 1199, "tex": "\\begin{enumerate}"}, {"line": 1200, "tex": "\\item $\\underline{\\Picardfunctor}_{X/k}$ is a disjoint union of"}, {"line": 1201, "tex": "$g$-dimensional smooth proper varieties $\\underline{\\Picardfunctor}^d_{X/k}$,"}, {"line": 1202, "tex": "\\item $k$-points of $\\underline{\\Picardfunctor}^d_{X/k}$"}, {"line": 1203, "tex": "correspond to invertible $\\mathcal{O}_X$-modules of degree $d$,"}, {"line": 1204, "tex": "\\item $\\underline{\\Picardfunctor}^0_{X/k}$"}, {"line": 1205, "tex": "is an open and closed subgroup scheme,"}, {"line": 1206, "tex": "\\item for $d \\geq 0$ there is a canonical morphism"}, {"line": 1207, "tex": "$\\gamma_d :"}, {"line": 1208, "tex": "\\underline{\\Hilbfunctor}^d_{X/k} \\to \\underline{\\Picardfunctor}^d_{X/k}$"}, {"line": 1209, "tex": "\\item the morphisms $\\gamma_d$"}, {"line": 1210, "tex": "are surjective for $d \\geq g$ and smooth for $d \\geq 2g - 1$,"}, {"line": 1211, "tex": "\\item the morphism"}, {"line": 1212, "tex": "$\\underline{\\Hilbfunctor}^g_{X/k} \\to \\underline{\\Picardfunctor}^g_{X/k}$"}, {"line": 1213, "tex": "is birational."}, {"line": 1214, "tex": "\\end{enumerate}"}, {"line": 1215, "tex": "\\end{lemma}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 1331, "section_label": "section-picard-curve", "section_start_line": 919, "section_title": "The Picard scheme of a curve", "source_file": "pic.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"environment": "lemma", "kind": "enter_local_environment", "line": 929, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 929, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 935, "persists_after_end": fals