{"candidate_ids": ["candidate.stacks.08c3a71b1b9c45d44f8e7284", "candidate.stacks.35310d00b81343796e5693b2"], "chapter_number": 44, "locally_named_context_leads": [], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 136, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 1332, "tex": "\\section{Some remarks on Picard groups}"}, {"line": 1333, "tex": "\\label{section-remarks-picard}"}, {"line": 1335, "tex": "\\noindent"}, {"line": 1336, "tex": "This section continues the discussion in"}, {"line": 1337, "tex": "Varieties, Section \\ref{varieties-section-picard-groups}"}, {"line": 1338, "tex": "and will be continued in"}, {"line": 1339, "tex": "Algebraic Curves, Section \\ref{curves-section-torsion-in-pic}."}, {"line": 1341, "tex": "\\begin{lemma}"}, {"line": 1342, "tex": "\\label{lemma-pic-descends}"}, {"line": 1343, "tex": "Let $k$ be a field. Let $X$ be a quasi-compact and quasi-separated scheme"}, {"line": 1344, "tex": "over $k$ with $H^0(X, \\mathcal{O}_X) = k$. If $X$ has a $k$-rational point,"}, {"line": 1345, "tex": "then for any Galois extension $k'/k$ we have"}, {"line": 1346, "tex": "$$"}, {"line": 1347, "tex": "\\Pic(X) = \\Pic(X_{k'})^{\\text{Gal}(k'/k)}"}, {"line": 1348, "tex": "$$"}, {"line": 1349, "tex": "Moreover the action of $\\text{Gal}(k'/k)$ on $\\Pic(X_{k'})$"}, {"line": 1350, "tex": "is continuous."}, {"line": 1351, "tex": "\\end{lemma}"}, {"line": 1408, "tex": "\\begin{lemma}"}, {"line": 1409, "tex": "\\label{lemma-torsion-descends}"}, {"line": 1410, "tex": "Let $k$ be a field of characteristic $p > 0$. Let $X$ be a"}, {"line": 1411, "tex": "quasi-compact and quasi-separated scheme over $k$ with"}, {"line": 1412, "tex": "$H^0(X, \\mathcal{O}_X) = k$. Let $n$ be an integer prime to $p$."}, {"line": 1413, "tex": "Then the map"}, {"line": 1414, "tex": "$$"}, {"line": 1415, "tex": "\\Pic(X)[n] \\longrightarrow \\Pic(X_{k'})[n]"}, {"line": 1416, "tex": "$$"}, {"line": 1417, "tex": "is bijective for any purely inseparable extension $k'/k$."}, {"line": 1418, "tex": "\\end{lemma}"}, {"line": 1507, "tex": "\\input{chapters}"}, {"line": 1509, "tex": "\\bibliography{my}"}, {"line": 1510, "tex": "\\bibliographystyle{amsalpha}"}, {"line": 1512, "tex": "\\end{document}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 1512, "section_label": "section-remarks-picard", "section_start_line": 1332, "section_title": "Some remarks on Picard groups", "source_file": "pic.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"environment": "lemma", "kind": "enter_local_environment", "line": 1341, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 1341, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 1351, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 1353, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 1408, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 1408, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 1418, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 1420, "scope_stack": []}]}
