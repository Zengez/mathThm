{"candidate_ids": ["candidate.stacks.64e26e133d41063bf1648f9b", "candidate.stacks.40a498602987f24d2144d3bb"], "chapter_number": 11, "locally_named_context_leads": [{"kind": "definition", "label": "definition-brauer-group", "line": 430}], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 24, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 380, "tex": "\\section{The Brauer group of a field}"}, {"line": 381, "tex": "\\label{section-brauer}"}, {"line": 383, "tex": "\\noindent"}, {"line": 384, "tex": "Let $k$ be a field. Consider two finite central simple algebras"}, {"line": 385, "tex": "$A$ and $B$ over $k$. We say $A$ and $B$ are {\\it similar} if there"}, {"line": 386, "tex": "exist $n, m > 0$ such that"}, {"line": 387, "tex": "$\\text{Mat}(n \\times n, A) \\cong \\text{Mat}(m \\times m, B)$"}, {"line": 388, "tex": "as $k$-algebras."}, {"line": 390, "tex": "\\begin{lemma}"}, {"line": 391, "tex": "\\label{lemma-similar}"}, {"line": 392, "tex": "Similarity."}, {"line": 393, "tex": "\\begin{enumerate}"}, {"line": 394, "tex": "\\item Similarity defines an equivalence relation on the set of isomorphism"}, {"line": 395, "tex": "classes of finite central simple algebras over $k$."}, {"line": 396, "tex": "\\item Every similarity class contains a unique (up to isomorphism)"}, {"line": 397, "tex": "finite central skew field extension of $k$."}, {"line": 398, "tex": "\\item If $A = \\text{Mat}(n \\times n, K)$ and $B = \\text{Mat}(m \\times m, K')$"}, {"line": 399, "tex": "for some finite central skew fields $K$, $K'$ over $k$"}, {"line": 400, "tex": "then $A$ and $B$ are similar if and only if $K \\cong K'$ as $k$-algebras."}, {"line": 401, "tex": "\\end{enumerate}"}, {"line": 402, "tex": "\\end{lemma}"}, {"line": 416, "tex": "\\noindent"}, {"line": 417, "tex": "Given two finite central simple $k$-algebras $A$, $B$ the tensor"}, {"line": 418, "tex": "product $A \\otimes_k B$ is another, see"}, {"line": 419, "tex": "Lemma \\ref{lemma-tensor-central-simple}."}, {"line": 420, "tex": "Moreover if $A$ is similar to $A'$, then $A \\otimes_k B$ is similar"}, {"line": 421, "tex": "to $A' \\otimes_k B$ because tensor products and taking matrix"}, {"line": 422, "tex": "algebras commute. Hence tensor product defines an operation on"}, {"line": 423, "tex": "equivalence classes of finite central simple algebras which is clearly"}, {"line": 424, "tex": "associative and commutative. Finally,"}, {"line": 425, "tex": "Lemma \\ref{lemma-inverse}"}, {"line": 426, "tex": "shows that $A \\otimes_k A^{op}$ is isomorphic to a matrix algebra, i.e.,"}, {"line": 427, "tex": "that $A \\otimes_k A^{op}$ is in the similarity class of $k$."}, {"line": 428, "tex": "Thus we obtain an abelian group."}, {"line": 430, "tex": "\\begin{definition}"}, {"line": 431, "tex": "\\label{definition-brauer-group}"}, {"line": 432, "tex": "Let $k$ be a field. The {\\it Brauer group} of $k$ is the abelian group"}, {"line": 433, "tex": "of similarity classes of finite central simple $k$-algebras defined"}, {"line": 434, "tex": "above. Notation $\\text{Br}(k)$."}, {"line": 435, "tex": "\\end{definition}"}, {"line": 437, "tex": "\\noindent"}, {"line": 438, "tex": "For any map of fields $k \\to k'$ we obtain a group homomorphism"}, {"line": 439, "tex": "$$"}, {"line": 440, "tex": "\\text{Br}(k) \\longrightarrow \\text{Br}(k'),\\quad"}, {"line": 441, "tex": "A \\longmapsto A \\otimes_k k'"}, {"line": 442, "tex": "$$"}, {"line": 443, "tex": "see Lemma \\ref{lemma-base-change}. In other words, $\\text{Br}(-)$ is"}, {"line": 444, "tex": "a functor from the category of fields to the category of abelian groups."}, {"line": 445, "tex": "Observe that the Brauer group"}, {"line": 446, "tex": "of a field is zero if and only if every finite central skew field"}, {"line": 447, "tex": "extension $k \\subset K$ is trivial."}, {"line": 449, "tex": "\\begin{lemma}"}, {"line": 450, "tex": "\\label{lemma-brauer-algebraically-closed}"}, {"line": 451, "tex": "The Brauer group of an algebraically closed field is zero."}, {"line": 452, "tex": "\\end{lemma}"}, {"line": 463, "tex": "\\begin{lemma}"}, {"line": 464, "tex": "\\label{lemma-dimension-square}"}, {"line": 465, "tex": "Let $A$ be a finite central simple algebra over a field $k$."}, {"line": 466, "tex": "Then $[A : k]$ is a square."}, {"line": 467, "tex": "\\end{lemma}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 477, "section_label": "section-brauer", "section_start_line": 380, "section_title": "The Brauer group of a field", "source_file": "brauer.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"environment": "lemma", "kind": "enter_local_environment", "line": 390, "persists_after_end": false, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 402, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 404, "scope_stack": []}, {"environment": "definition", "kind": "enter_local_environment", "line": 430, "persists_after_end": false, "scope_stack": ["definition"]}, {"environment": "definition", "kind": "exit_local_environment", "line": 435, "persists_after_end": false, "scope_stack_before_pop": ["definition"]}, {"environment": "lemma", "kind": "enter_local_environment", "line": 449, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 449, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 452, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 454, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 463, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 463, "scope_stack": ["lemma"]}, {"environm