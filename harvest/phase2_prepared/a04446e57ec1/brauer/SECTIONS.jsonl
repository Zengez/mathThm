{"candidate_ids": ["candidate.stacks.4dde9aabdfc31abf7aa6feeb", "candidate.stacks.97664cc93ff0b344b8dd1988", "candidate.stacks.590d23a3913c1139ed9364c6", "candidate.stacks.0f085b768968501af042d085"], "chapter_number": 11, "locally_named_context_leads": [], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 41, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 524, "tex": "\\section{The centralizer theorem}"}, {"line": 525, "tex": "\\label{section-centralizer}"}, {"line": 528, "tex": "\\begin{theorem}"}, {"line": 529, "tex": "\\label{theorem-centralizer}"}, {"line": 530, "tex": "Let $A$ be a finite central simple algebra over $k$, and let"}, {"line": 531, "tex": "$B$ be a simple subalgebra of $A$. Then"}, {"line": 532, "tex": "\\begin{enumerate}"}, {"line": 533, "tex": "\\item the centralizer $C$ of $B$ in $A$ is simple,"}, {"line": 534, "tex": "\\item $[A : k] = [B : k][C : k]$, and"}, {"line": 535, "tex": "\\item the centralizer of $C$ in $A$ is $B$."}, {"line": 536, "tex": "\\end{enumerate}"}, {"line": 537, "tex": "\\end{theorem}"}, {"line": 566, "tex": "\\begin{lemma}"}, {"line": 567, "tex": "\\label{lemma-when-tensor-is-equal}"}, {"line": 568, "tex": "Let $A$ be a finite central simple algebra over $k$, and let"}, {"line": 569, "tex": "$B$ be a simple subalgebra of $A$. If $B$ is a central"}, {"line": 570, "tex": "$k$-algebra, then $A = B \\otimes_k C$ where $C$ is the (central simple)"}, {"line": 571, "tex": "centralizer of $B$ in $A$."}, {"line": 572, "tex": "\\end{lemma}"}, {"line": 582, "tex": "\\begin{lemma}"}, {"line": 583, "tex": "\\label{lemma-self-centralizing-subfield}"}, {"line": 584, "tex": "Let $A$ be a finite central simple algebra over $k$."}, {"line": 585, "tex": "If $K \\subset A$ is a subfield, then the following are equivalent"}, {"line": 586, "tex": "\\begin{enumerate}"}, {"line": 587, "tex": "\\item $[A : k] = [K : k]^2$,"}, {"line": 588, "tex": "\\item $K$ is its own centralizer, and"}, {"line": 589, "tex": "\\item $K$ is a maximal commutative subring."}, {"line": 590, "tex": "\\end{enumerate}"}, {"line": 591, "tex": "\\end{lemma}"}, {"line": 599, "tex": "\\begin{lemma}"}, {"line": 600, "tex": "\\label{lemma-maximal-subfield}"}, {"line": 601, "tex": "\\begin{slogan}"}, {"line": 602, "tex": "The dimension of a finite central skew field is the square of the dimension"}, {"line": 603, "tex": "of any maximal subfield."}, {"line": 604, "tex": "\\end{slogan}"}, {"line": 605, "tex": "Let $A$ be a finite central skew field over $k$."}, {"line": 606, "tex": "Then every maximal subfield $K \\subset A$ satisfies"}, {"line": 607, "tex": "$[A : k] = [K : k]^2$."}, {"line": 608, "tex": "\\end{lemma}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 617, "section_label": "section-centralizer", "section_start_line": 524, "section_title": "The centralizer theorem", "source_file": "brauer.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"environment": "theorem", "kind": "enter_local_environment", "line": 528, "persists_after_end": false, "scope_stack": ["theorem"]}, {"kind": "candidate_location", "line": 528, "scope_stack": ["theorem"]}, {"environment": "theorem", "kind": "exit_local_environment", "line": 537, "persists_after_end": false, "scope_stack_before_pop": ["theorem"]}, {"kind": "proof_skipped", "line": 539, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 566, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 566, "scope_stack": ["lemma"]}, {"environment": "lemma", "kind": "exit_local_environment", "line": 572, "persists_after_end": false, "scope_stack_before_pop": ["lemma"]}, {"kind": "proof_skipped", "line": 574, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 582, "persist