{"candidate_ids": ["candidate.stacks.74fb184add471521e57e97df", "candidate.stacks.e9e4caf291c85710d2884695", "candidate.stacks.810f0af13b004f6c6bdb52c8", "candidate.stacks.a00f2cfdc272b9daf77f47fa"], "chapter_number": 11, "locally_named_context_leads": [{"kind": "definition", "label": "definition-splitting", "line": 622}], "no_ambient_hypotheses_inferred": true, "omitted_proof_line_count": 106, "possible_scope_prose_line_numbers": [], "previous_draft_artifact_hint": null, "proof_free_source_lines": [{"line": 618, "tex": "\\section{Splitting fields}"}, {"line": 619, "tex": "\\label{section-splitting}"}, {"line": 622, "tex": "\\begin{definition}"}, {"line": 623, "tex": "\\label{definition-splitting}"}, {"line": 624, "tex": "Let $A$ be a finite central simple $k$-algebra."}, {"line": 625, "tex": "We say a field extension $k'/k$ {\\it splits} $A$, or"}, {"line": 626, "tex": "$k'$ is a {\\it splitting field} for $A$ if $A \\otimes_k k'$ is"}, {"line": 627, "tex": "a matrix algebra over $k'$."}, {"line": 628, "tex": "\\end{definition}"}, {"line": 630, "tex": "\\noindent"}, {"line": 631, "tex": "Another way to say this is that the class of $A$ maps to zero"}, {"line": 632, "tex": "under the map $\\text{Br}(k) \\to \\text{Br}(k')$."}, {"line": 634, "tex": "\\begin{theorem}"}, {"line": 635, "tex": "\\label{theorem-splitting}"}, {"line": 636, "tex": "Let $A$ be a finite central simple $k$-algebra."}, {"line": 637, "tex": "Let $k'/k$ be a finite field extension."}, {"line": 638, "tex": "The following are equivalent"}, {"line": 639, "tex": "\\begin{enumerate}"}, {"line": 640, "tex": "\\item $k'$ splits $A$, and"}, {"line": 641, "tex": "\\item there exists a finite central simple algebra $B$ similar to $A$"}, {"line": 642, "tex": "such that $k' \\subset B$ and $[B : k] = [k' : k]^2$."}, {"line": 643, "tex": "\\end{enumerate}"}, {"line": 644, "tex": "\\end{theorem}"}, {"line": 678, "tex": "\\begin{lemma}"}, {"line": 679, "tex": "\\label{lemma-maximal-subfield-splits}"}, {"line": 680, "tex": "A maximal subfield of a finite central skew field $K$ over $k$ is"}, {"line": 681, "tex": "a splitting field for $K$."}, {"line": 682, "tex": "\\end{lemma}"}, {"line": 689, "tex": "\\begin{lemma}"}, {"line": 690, "tex": "\\label{lemma-splitting-field-degree}"}, {"line": 691, "tex": "Consider a finite central skew field $K$ over $k$. Let $d^2 = [K : k]$."}, {"line": 692, "tex": "For any finite splitting field $k'$ for $K$ the degree $[k' : k]$ is"}, {"line": 693, "tex": "divisible by $d$."}, {"line": 694, "tex": "\\end{lemma}"}, {"line": 705, "tex": "\\begin{proposition}"}, {"line": 706, "tex": "\\label{proposition-separable-splitting-field}"}, {"line": 707, "tex": "Consider a finite central skew field $K$ over $k$."}, {"line": 708, "tex": "There exists a maximal subfield $k \\subset k' \\subset K$ which"}, {"line": 709, "tex": "is separable over $k$."}, {"line": 710, "tex": "In particular, every Brauer class has a finite separable"}, {"line": 711, "tex": "spitting field."}, {"line": 712, "tex": "\\end{proposition}"}, {"line": 763, "tex": "\\noindent"}, {"line": 764, "tex": "The results above allow us to characterize finite central simple algebras"}, {"line": 765, "tex": "as follows."}, {"line": 767, "tex": "\\begin{lemma}"}, {"line": 768, "tex": "\\label{lemma-finite-central-simple-algebra}"}, {"line": 769, "tex": "Let $k$ be a field. For a $k$-algebra $A$ the following are equivalent"}, {"line": 770, "tex": "\\begin{enumerate}"}, {"line": 771, "tex": "\\item $A$ is finite central simple $k$-algebra,"}, {"line": 772, "tex": "\\item $A$ is a finite dimensional $k$-vector space, $k$ is the center of $A$,"}, {"line": 773, "tex": "and $A$ has no nontrivial two-sided ideal,"}, {"line": 774, "tex": "\\item there exists $d \\geq 1$ such that"}, {"line": 775, "tex": "$A \\otimes_k \\bar k \\cong \\text{Mat}(d \\times d, \\bar k)$,"}, {"line": 776, "tex": "\\item there exists $d \\geq 1$ such that"}, {"line": 777, "tex": "$A \\otimes_k k^{sep} \\cong \\text{Mat}(d \\times d, k^{sep})$,"}, {"line": 778, "tex": "\\item there exist $d \\geq 1$ and a finite Galois extension $k'/k$"}, {"line": 779, "tex": "such that"}, {"line": 780, "tex": "$A \\otimes_k k' \\cong \\text{Mat}(d \\times d, k')$,"}, {"line": 781, "tex": "\\item there exist $n \\geq 1$ and a finite central skew field $K$"}, {"line": 782, "tex": "over $k$ such that $A \\cong \\text{Mat}(n \\times n, K)$."}, {"line": 783, "tex": "\\end{enumerate}"}, {"line": 784, "tex": "The integer $d$ is called the {\\it degree} of $A$."}, {"line": 785, "tex": "\\end{lemma}"}, {"line": 812, "tex": "\\input{chapters}"}, {"line": 814, "tex": "\\bibliography{my}"}, {"line": 815, "tex": "\\bibliographystyle{amsalpha}"}, {"line": 817, "tex": "\\end{document}"}], "schema": "maththm.phase2.chapter-section-input.v1", "scope_extraction_error_requires_review": null, "section_end_line": 817, "section_label": "section-splitting", "section_start_line": 618, "section_title": "Splitting fields", "source_file": "brauer.tex", "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scope_events_unadjudicated": [{"environment": "definition", "kind": "enter_local_environment", "line": 622, "persists_after_end": false, "scope_stack": ["definition"]}, {"environment": "definition", "kind": "exit_local_environment", "line": 628, "persists_after_end": false, "scope_stack_before_pop": ["definition"]}, {"environment": "theorem", "kind": "enter_local_environment", "line": 634, "persists_after_end": false, "scope_stack": ["theorem"]}, {"kind": "candidate_location", "line": 634, "scope_stack": ["theorem"]}, {"environment": "theorem", "kind": "exit_local_environment", "line": 644, "persists_after_end": false, "scope_stack_before_pop": ["theorem"]}, {"kind": "proof_skipped", "line": 646, "scope_stack": []}, {"environment": "lemma", "kind": "enter_local_environment", "line": 678, "persists_after_end": false, "scope_stack": ["lemma"]}, {"kind": "candidate_location", "line": 678, "scope_stack": ["lem