 Y$ be a proper morphism of quasi-compact and\nquasi-separated schemes. Let $V \\subset Y$ be a quasi-compact open\nand $U = f^{-1}(V)$. Let $T \\subset V$ be a closed subset such that\n$f|_U : U \\to V$ is an isomorphism over an open neighbourhood of $T$\nin $V$."], "original_source_statement_tex": "\\label{lemma-blowup-iso-along}\nLet $f : X \\to Y$ be a proper morphism of quasi-compact and\nquasi-separated schemes. Let $V \\subset Y$ be a quasi-compact open\nand $U = f^{-1}(V)$. Let $T \\subset V$ be a closed subset such that\n$f|_U : U \\to V$ is an isomorphism over an open neighbourhood of $T$\nin $V$. Then there exists a $V$-admissible blowing up $Y' \\to Y$\nsuch that the strict transform $f' : X' \\to Y'$ of $f$\nis an isomorphism over an open neighbourhood of the closure\nof $T$ in $Y'$.", "pass3_eligible": false, "published": false, "schema": "maththm.four-complete-chapters.standalone-editorial-draft.v1", "section_ambient_hypotheses_auto_inherited": [], "section_end_line": 10001, "section_index": 194, "section_key": "s194", "section_start_line": 9532, "section_title": "Nagata compactification", "source_enumerated_clauses": [], "source_filename": "flat.tex", "source_formal_environment": "lemma", "source_formal_environment_end_line": 9617, "source_formal_environment_start_line": 9607, "source_inline_reference_labels": [], "source_label": "lemma-blowup-iso-along", "source_logical_form": "plain_source_statement", "source_named_reference_labels": [], "source_proof_screened": false, "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scoped_conventions_and_situations": [], "source_statement_line": 9607, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/flat.tex#L9607", "standalone_statement_tex": "Let $f : X \\to Y$ be a proper morphism of quasi-compact and\nquasi-separated schemes. Let $V \\subset Y$ be a quasi-compact open\nand $U = f^{-1}(V)$. Let $T \\subset V$ be a closed subset such that\n$f|_U : U \\to V$ is an isomorphism over an open neighbourhood of $T$\nin $V$. Then there exists a $V$-admissible blowing up $Y' \\to Y$\nsuch that the strict transform $f' : X' \\to Y'$ of $f$\nis an isomorphism over an open neighbourhood of the closure\nof $T$ in $Y'$."}
