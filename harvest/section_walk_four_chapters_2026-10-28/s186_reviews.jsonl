_eligible": false, "published": false, "schema": "maththm.four-complete-chapters.standalone-editorial-draft.v1", "section_ambient_hypotheses_auto_inherited": [], "section_end_line": 7551, "section_index": 186, "section_key": "s186", "section_start_line": 6995, "section_title": "Variants of a lemma", "source_enumerated_clauses": [], "source_filename": "flat.tex", "source_formal_environment": "lemma", "source_formal_environment_end_line": 7375, "source_formal_environment_start_line": 7370, "source_inline_reference_labels": [], "source_label": "lemma-closed-points-complement", "source_logical_form": "plain_source_statement", "source_named_reference_labels": [], "source_proof_screened": false, "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_statement_line": 7370, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/flat.tex#L7370", "standalone_statement_tex": "Let $A$ be a local ring. Let $I, J \\subset A$ be ideals.\nIf $J$ is finitely generated and $I \\subset J^n$ for all $n \\geq 1$,\nthen $V(I)$ contains the closed points of $\\Spec(A) \\setminus V(J)$."}
