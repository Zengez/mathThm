sed-immersion-and-integral", "definition-affine-stratification", "definition-affine-stratification-number", "definition-weighting", "definition-cd-morphism", "definition-one-step-devissage", "definition-one-step-devissage-at-x", "definition-shrink", "definition-complete-devissage", "definition-complete-devissage-at-x", "definition-shrink-complete", "definition-elementary-etale-neighbourhood", "definition-complete-devissage-algebra", "definition-complete-devissage-at-x-algebra", "situation-pre-pure", "definition-impurity", "definition-pure"], "candidate_id": "candidate.stacks.9a8c0855a9170a4bd25da9e6", "chapter_order": 38, "context_resolution_needed": [], "context_review_status": "standalone_draft_ready_for_validation", "draft_conclusions": ["$\\mathcal{F}$ is pure relative to $S$,", "the scheme theoretic support of $\\mathcal{F}$ is finite over $S$, and", "$\\mathcal{F}$ is universally pure relative to $S$."], "draft_hypotheses": ["Let $f : X \\to S$ be a separated, finite type morphism of schemes.\nLet $\\mathcal{F}$ be a finite type, quasi-coherent $\\mathcal{O}_X$-module.\nAssume that $\\text{Supp}(\\mathcal{F}_s)$ is finite for every $s \\in S$."], "final_mathematical_source_equivalence_approved": false, "inherited_context_review_decision": "only source definitions available, no unreviewed premises imported", "local_lemma_hypotheses_expire_at_end": true, "named_definitions_are_not_ambient_assumptions": true, "original_pass1_pass2_unchanged": true, "original_pass2_conclusions_proposed": ["$\\mathcal{F}$ is pure relative to $S$,", "the scheme theoretic support of $\\mathcal{F}$ is finite over $S$, and", "$\\mathcal{F}$ is universally pure relative to $S$.", "In particular, given a quasi-finite separated morphism $X \\to S$ we see\nthat $X$ is pure relative to $S$ if and only if $X \\to S$ is finite."], "original_pass2_hypotheses_proposed": ["Let $f : X \\to S$ be a separated, finite type morphism of schemes.\nLet $\\mathcal{F}$ be a finite type, quasi-coherent $\\mathcal{O}_X$-module.\nAssume that $\\text{Supp}(\\mathcal{F}_s)$ is finite for every $s \\in S$.\nThen", "$\\mathcal{F}$ is pure relative to $S$,", "the scheme theoretic support of $\\mathcal{F}$ is finite over $S$, and", "$\\mathcal{F}$ is universally pure relative to $S$."], "original_source_statement_tex": "\\label{lemma-quasi-finite-pure}\nLet $f : X \\to S$ be a separated, finite type morphism of schemes.\nLet $\\mathcal{F}$ be a finite type, quasi-coherent $\\mathcal{O}_X$-module.\nAssume that $\\text{Supp}(\\mathcal{F}_s)$ is finite for every $s \\in S$.\nThen the following are equivalent\n\\begin{enumerate}\n\\item $\\mathcal{F}$ is pure relative to $S$,\n\\item the scheme theoretic support of $\\mathcal{F}$ is finite over $S$, and\n\\item $\\mathcal{F}$ is universally pure relative to $S$.\n\\end{enumerate}\nIn particular, given a quasi-finite separated morphism $X \\to S$ we see\nthat $X$ is pure relative to $S$ if and only if $X \\to S$ is finite.", "pass3_eligible": false, "published": false, "schema": "maththm.four-complete-chapters.standalone-editorial-draft.v1", "section_ambient_hypotheses_auto_inherited": [], "section_end_line": 5164, "section_index": 178, "section_key": "s178", "section_start_line": 5009, "section_title": "Examples of relatively pure sheaves", "source_enumerated_clauses": ["$\\mathcal{F}$ is pure relative to $S$,", "the scheme theoretic support of $\\mathcal{F}$ is finite over $S$, and", "$\\mathcal{F}$ is universally pure relative to $S$."], "source_filename": "flat.tex", "source_formal_environment": "lemma", "source_formal_environment_end_line": 5059, "source_formal_environment_start_line": 5046, "source_inline_reference_labels": [], "source_label": "lemma-quasi-finite-pure", "source_logical_form": "equivalent_conditions", "source_named_reference_labels": [], "source_proof_screened": false, "source_revision": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_scoped_conventions_and_situations": [], "source_statement_line": 5046, "source_url": "https://github.com/stacks/stacks-project/blob/a04446e57ec1fbc252a871afcec7752fb2807b14/flat.tex#L5046", "standalone_statement_tex": "Let $f : X \\to S$ be a separated, finite type morphism of schemes.\nLet $\\mathcal{F}$ be a finite type, quasi-coherent $\\mathcal{O}_X$-module.\nAssume that $\\text{Supp}(\\mathcal{F}_s)$ is finite for every $s \\in S$.\nThen the following are equivalent\n\\begin{enumerate}\n\\item $\\mathcal{F}$ is pure relative to $S$,\n\\item the scheme theoretic support of $\\mathcal{F}$ is finite over $S$, and\n\\item $\\mathcal{F}$ is universally pure relative to $S$.\n\\end{enumerate}\nIn particular, given a quasi-finite separated morphism $X \\to S$ we see\nthat $X$ is pure relative to $S$ if and only if $X \\to S$ is finite."}
